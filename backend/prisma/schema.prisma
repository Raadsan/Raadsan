generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int      @id @default(autoincrement())
  fullName    String   @db.VarChar(160)
  email       String   @unique
  password    String   @db.VarChar(120)
  confirmPass String   @db.VarChar(120)
  roleId      Int
  role        Role     @relation(fields: [roleId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("users")
}

model Role {
  id              Int              @id @default(autoincrement())
  name            String           @db.VarChar(160)
  description     String?          @db.VarChar(500)
  users           User[]
  rolePermissions RolePermission[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("roles")
}

model Menu {
  id              Int              @id @default(autoincrement())
  title           String           @db.VarChar(160)
  url             String?          @db.VarChar(255)
  icon            String?          @db.VarChar(100)
  order           Int              @default(0)
  parentId        Int?
  parent          Menu?            @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children        Menu[]           @relation("MenuHierarchy")
  rolePermissions RolePermission[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([parentId])
  @@map("menus")
}

model RolePermission {
  id        Int      @id @default(autoincrement())
  roleId    Int
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  menuId    Int
  menu      Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  canView   Boolean  @default(true)
  canCreate Boolean  @default(false)
  canEdit   Boolean  @default(false)
  canDelete Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roleId, menuId])
  @@index([roleId])
  @@index([menuId])
  @@map("role_permissions")
}

// home models
model Service {
  id          Int    @id @default(autoincrement())
  slug        String @unique @db.VarChar(120)
  title       String @db.VarChar(160)
  badge       String @db.VarChar(80)
  description String @db.Text
  features    Json
  order       Int    @default(0)

  @@map("services")
}

model HostingPlan {
  id           Int     @id @default(autoincrement())
  slug         String  @unique @db.VarChar(120)
  name         String  @db.VarChar(150)
  badge        String? @db.VarChar(100)
  popular      Boolean @default(false)
  description  String  @db.VarChar(500)
  monthlyPrice Decimal @db.Decimal(10, 2)
  yearlyPrice  Decimal @db.Decimal(10, 2)
  /// e.g. ["1 Website", "20 GB NVMe SSD", "Unmetered", ...]
  features     Json
  ctaText      String  @db.VarChar(100)
  order        Int     @default(0)

  @@map("hosting_plans")
}

model Achievement {
  id     Int    @id @default(autoincrement())
  slug   String @unique @db.VarChar(120)
  count  String @db.VarChar(40)
  label  String @db.VarChar(160)
  icon   String @db.VarChar(500)
  order  Int    @default(0)

  @@map("achievements")
}

model Partner {
  id        Int     @id @default(autoincrement())
  title     String  @db.VarChar(160)
  image     String  @db.VarChar(500)
  imageDark String? @db.VarChar(500)
  order     Int     @default(0)

  @@map("partners")
}

model BlogCategory {
  id    Int    @id @default(autoincrement())
  slug  String @unique @db.VarChar(120)
  title String @db.VarChar(120)
  blogs Blog[]

  @@map("blog_categories")
}

model Blog {
  id         Int          @id @default(autoincrement())
  slug       String       @unique @db.VarChar(180)
  title      String       @db.VarChar(255)
  excerpt    String       @db.Text
  content    String?      @db.LongText
  hashtags   Json?
  categoryId Int
  category   BlogCategory @relation(fields: [categoryId], references: [id])
  date       DateTime
  readTime   String       @db.VarChar(40)
  author     String       @db.VarChar(120)
  image      String       @db.VarChar(500)
  order      Int          @default(0)

  @@index([categoryId])
  @@map("blogs")
}

model Testimonial {
  id       Int     @id @default(autoincrement())
  name     String  @db.VarChar(120)
  role     String  @db.VarChar(120)
  company  String  @db.VarChar(160)
  content  String  @db.Text
  rating   Int     @default(5)
  initials String  @db.VarChar(4)
  profile  String? @db.VarChar(500)
  order    Int     @default(0)

  @@map("testimonials")
}

model Faq {
  id       Int    @id @default(autoincrement())
  question String @db.VarChar(500)
  answer   String @db.Text
  order    Int    @default(0)

  @@map("faqs")
}


// contact models
model ContactHero {
  id        Int    @id @default(autoincrement())
  title     String @db.VarChar(120)
  highlight String @db.VarChar(120)
  subtitle  String @db.Text
  order     Int    @default(0)

  @@map("contact_heroes")
}

model ContactInformation {
  id    Int    @id @default(autoincrement())
  /// mail | phone | map | facebook | instagram | linkedin | github
  icon  String @db.VarChar(40)
  label String @db.VarChar(120)
  value String @db.Text
  /// For social icons, value is the URL
  href  String? @db.VarChar(500)
  order Int    @default(0)

  @@map("contact_information")
}

model ContactSubmission {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(160)
  email     String   @db.VarChar(200)
  subject   String?  @db.VarChar(255)
  phone     String   @db.VarChar(60)
  message   String   @db.Text
  createdAt DateTime @default(now())

  @@map("contact_submissions")
}

// products
model Product {
  id          Int    @id @default(autoincrement())
  title       String @db.VarChar(160)
  slug        String @unique @db.VarChar(120)
  description String @db.VarChar(500)
  /// [{ icon, title, description }]
  features    Json
  order       Int    @default(0)

  @@map("products")
}

// about models
model AboutCompany {
  id      Int    @id @default(autoincrement())
  title   String @db.VarChar(120)
  content String @db.Text
  image   String @db.VarChar(500)

  @@map("about_companies")
}

model AboutVisionMission {
  id    Int    @id @default(autoincrement())
  /// vision | mission
  type  String @db.VarChar(20)
  title String @db.VarChar(120)
  text  String @db.Text
  icon  String @db.VarChar(40)
  order Int    @default(0)

  @@map("about_vision_missions")
}

model AboutCoreValue {
  id    Int    @id @default(autoincrement())
  title String @db.VarChar(120)
  text  String @db.Text
  icon  String @db.VarChar(40)
  order Int    @default(0)

  @@map("about_core_values")
}

model AboutWhyChoose {
  id    Int    @id @default(autoincrement())
  title String @db.VarChar(160)
  text  String @db.Text
  icon  String @db.VarChar(40)
  order Int    @default(0)

  @@map("about_why_choose")
}

